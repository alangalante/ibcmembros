# Firebase Web SDK (seguros para o navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (somente servidor/Vercel)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Segredo aleatório compartilhado com o Vercel Cron/GitHub Actions
CRON_SECRET=

# Cloudinary (upload assinado; somente nome pode ser público)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usado pelo script de migração local (alternativa às 3 variáveis Admin acima)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
