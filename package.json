{
  "name": "ibc-membros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "migrate:members": "tsx scripts/import-members.ts",
    "migration:prepare": "python3 scripts/prepare-migration.py",
    "migration:backup": "tsx scripts/backup-production.ts",
    "migration:execute": "tsx scripts/execute-migration.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "csv-parse": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "sharp": ">=0.35.0"
  }
}
